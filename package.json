{
  "name": "archer",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first bulk email: CSV audiences, HTML templates, SES/SMTP, warm-up, and CAN-SPAM controls — data stays on your machine.",
  "keywords": [
    "email",
    "bulk-email",
    "ses",
    "smtp",
    "local-first",
    "newsletter",
    "can-spam",
    "sqlite",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ojs393/Archer.git"
  },
  "homepage": "https://github.com/ojs393/Archer#readme",
  "bugs": {
    "url": "https://github.com/ojs393/Archer/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "selftest": "node --disable-warning=ExperimentalWarning --import tsx server/selftest.ts",
    "seed:local": "node --disable-warning=ExperimentalWarning --import tsx scripts/seed-local.mjs",
    "start": "node scripts/doctor.mjs --quick && node --disable-warning=ExperimentalWarning --import tsx server/supervisor.ts",
    "dev": "node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "build:web": "vite build --config config/vite.config.ts",
    "dev:web": "vite --config config/vite.config.ts",
    "build:icons": "node scripts/build-icons.mjs",
    "capture:screenshots": "node scripts/capture-readme-shots.mjs",
    "typecheck": "tsc --noEmit -p config/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.7",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.3",
    "fastify": "5.12.7",
    "html-to-text": "10.0.1",
    "lucide-react": "1.61.0",
    "nodemailer": "10.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "smtp-server": "3.21.1",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.1",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/html-to-text": "9.0.4",
    "@types/node": "22.16.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/smtp-server": "3.5.13",
    "@vitejs/plugin-react-swc": "4.3.3",
    "autoprefixer": "10.6.1",
    "jsdom": "29.1.1",
    "playwright": "^1.56.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "vite": "$vite"
  }
}
