# Copy to .env only if you want to override defaults. `npm run setup` creates .env for you.

# HTTP port for the dashboard (default 5199; the next free port is used if busy).
PORT=5199

# Absolute path for the database, uploads, logs, and backups (default: <project>/data).
MAMADIRECT_DATA_DIR=

# HMAC key for unsubscribe links. Generated by setup; never change it once mail has been sent,
# or previously sent unsubscribe links stop working.
UNSUB_SECRET=

# SMTP password. Written by the app when you save SMTP settings; never shown in the UI.
SMTP_PASS=
