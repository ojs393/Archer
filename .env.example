# Example only. `npm run setup` writes a real `.env` for you — never commit that file.

# HTTP port for the dashboard (default 5199; next free port if busy).
PORT=5199

# Absolute path for the database, uploads, logs, and backups (default: <project>/data).
ARCHER_DATA_DIR=

# HMAC key for unsubscribe links. Generated by setup; do not change after real mail is sent,
# or older unsubscribe links stop working.
UNSUB_SECRET=

# SMTP password. Written when you save SMTP settings; never shown in the UI.
SMTP_PASS=
