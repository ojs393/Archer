{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "../server",
    "../tests",
    "../scripts/**/*.d.mts",
    "./vitest.config.ts",
    "./vite.config.ts",
    "./tailwind.config.ts"
  ]
}
